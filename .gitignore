# Audio Data
# ==============================
# Keep raw audio out of Git by default.
# Remove this rule if you explicitly want to publish audio.
/data/audio/

# ==============================
# Transcripts
# ==============================
# Keep transcripts tracked, provided they are safe to publish.
!/data/transcripts/

# ==============================
# Experiment Results
# ==============================
# Keep CSV metrics, generated TTS audio and model outputs tracked.
!/results/

